[
  {"term":"가나안","text":"요단강과 지중해 사이를 중심으로 한 지역입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/canaan_nkt_glo"},
  {"term":"가말리엘","text":"바울의 스승으로 알려진 바리새파 율법 교사입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/gamaliel_nkt_glo"},
  {"term":"가버나움","text":"갈릴리 호수 북쪽 연안의 도시로, 예수님이 자주 머무셨습니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/capernaum_nkt_glo"},
  {"term":"가브리엘","text":"하나님의 말씀을 전하는 천사로 성경에 등장합니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/gabriel_nkt_glo"},
  {"term":"가시관","text":"가시나무 가지로 엮어 예수님의 머리에 씌운 관입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/crown_of_thorns_nkt_glo"},
  {"term":"가죽 부대","text":"짐승 가죽을 꿰매 물이나 포도주를 담아 옮기던 자루입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/wineskin_nkt_glo"},
  {"term":"간다게","text":"에티오피아 여왕을 가리키는 칭호입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/candace_nkt_glo"},
  {"term":"갈라디아","text":"오늘날 튀르키예 중부에 해당하는 소아시아 지역입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/galatia_nkt_glo"},
  {"term":"겟세마네","text":"이름은 '기름 짜는 틀'이라는 뜻으로, 올리브산 서쪽의 동산입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_glossary/gethsemane_nkt_glo"},
  {"term":"규빗","text":"팔꿈치부터 손끝까지를 기준으로 한 길이 단위로, 보통 약 46cm입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_units/nkt_units_length"},
  {"term":"세겔","text":"무게 단위로, 보통 세겔은 약 11.5g입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_units/nkt_units_weight"},
  {"term":"스다디온","text":"거리 단위로, 약 185m입니다.","sourceUrl":"https://bible.bskorea.or.kr/resources/study/nkt_units/nkt_units_distance"}
]
